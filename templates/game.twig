<tr class="game-row"
        {% if game.isInstalled %} data-game-is-installed="1" {% endif %}
        {% if game.isCouchCoopGame %} data-game-is-couch-coop="1" {% endif %}
        {% if game.isFavorite %} data-game-is-favorite="1" {% endif %}
>
    <td class="game-column game-column-name" data-label="Title">
        <div class="game-card-header">
            <div class="game-card-title">{{ game.name }}</div>
            <div class="game-card-aside">
                {% if game.playtime.inHours > 0 %}
                    <span class="game-card-playtime">{{ game.playtime.inHours }} h</span>
                {% endif %}
                <div class="game-card-platform-summary">
                    <img src="{{ game.platform.iconPath }}"
                         alt="{{ game.platform.name }}"
                         title="{{ game.platform.name }}"
                         class="game-column-platform-icon game-column-platform-icon-{{ game.platform.name|lower|replace({' ':'-','(':'',')':'','.':'-'}) }}"
                    />
                    <span class="game-card-platform-name">{{ game.platform.name }}</span>
                </div>
            </div>
        </div>
        <div class="game-card-status">
            {% if game.isInstalled %}
                <span class="game-status-pill"><span aria-hidden="true">🎮</span><span>Installed</span></span>
            {% endif %}
            {% if game.isFavorite %}
                <span class="game-status-pill"><span aria-hidden="true">⭐️</span><span>Favorite</span></span>
            {% endif %}
            {% if game.isCouchCoopGame %}
                <span class="game-status-pill"><span aria-hidden="true">🤝</span><span>Couch co-op</span></span>
            {% endif %}
        </div>
    </td>
    <td class="game-column game-column-playtime" data-label="Playtime">
        <time datetime="PT{{ game.playtime.inHours }}H">
            {% if game.playtime.inHours > 0 %}
                {{ game.playtime.inHours }} h
            {% endif %}
        </time>
    </td>
    <td class="game-column game-column-platform" data-label="Platform">
        <img src="{{ game.platform.iconPath }}"
             alt="{{ game.platform.name }}"
             title="{{ game.platform.name }}"
             class="game-column-platform-icon game-column-platform-icon-{{ game.platform.name|lower|replace({' ':'-','(':'',')':'','.':'-'}) }}"
        />
    </td>
    <td class="game-column game-column-installed" data-label="Installed?">
        {{ game.isInstalled ? "🎮" }}
    </td>
    <td class="game-column game-column-favorite" data-label="Favorite?">
        {{ game.isFavorite ? "⭐️" }}
    </td>
    <td class="game-column game-column-couch-coop" data-label="Couch Coop?">
        {{ game.isCouchCoopGame ? "🤝" }}
    </td>
    <td class="game-column game-column-genres{% if game.genres|length == 0 %} game-column-is-empty{% endif %}" data-label="Genres">
        {% if game.genres|length > 0 %}
            <ul class="genre-tags">
                {% for genre in game.genres %}
                    <li class="genre-tag{% if loop.index > 3 %} genre-tag-mobile-hidden{% endif %}">{{ genre.name }}</li>
                {% endfor %}
                {% if game.genres|length > 3 %}
                    <li class="genre-tag-overflow">
                        <button
                            type="button"
                            class="genre-tag genre-tag-toggle"
                            aria-expanded="false"
                            aria-label="Show {{ game.genres|length - 3 }} more genres"
                            data-collapsed-label="+{{ game.genres|length - 3 }}"
                            data-expanded-label="Less"
                        >
                            +{{ game.genres|length - 3 }}
                        </button>
                    </li>
                {% endif %}
            </ul>
        {% endif %}
    </td>
    <td class="game-column game-column-score{% if not (game.communityScore.value or game.criticScore.value) %} game-column-is-empty{% endif %}" data-label="Score">
        {% if game.communityScore.value or game.criticScore.value %}
            {% if game.communityScore.value %}
            <div class="game-score game-score-community{% if game.communityScore.value >= 90 %} game-score-excellent{% elseif game.communityScore.value >= 75 %} game-score-good{% elseif game.communityScore.value >= 60 %} game-score-fair{% else %} game-score-poor{% endif %}">
                <label title="Community score"><span>Users</span><span>{{ game.communityScore.value }}</span></label>
                <meter min="0" max="100" low="50" high="75" optimum="90" value="{{ game.communityScore.value }}" title="Community score"></meter>
            </div>
            {% endif %}
            {% if game.criticScore.value %}
            <div class="game-score game-score-critic{% if game.criticScore.value >= 90 %} game-score-excellent{% elseif game.criticScore.value >= 75 %} game-score-good{% elseif game.criticScore.value >= 60 %} game-score-fair{% else %} game-score-poor{% endif %}">
                <label title="Critic score"><span>Critic</span><span>{{ game.criticScore.value }}</span></label>
                <meter min="0" max="100" low="50" high="75" optimum="90" value="{{ game.criticScore.value }}" title="Critic score"></meter>
            </div>
            {% endif %}
        {% endif %}
    </td>
</tr>
