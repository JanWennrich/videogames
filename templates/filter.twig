<div id="filter" class="filter-bar">
    <label for="freetext-filter" class="filter-search">
        <span>Filter</span>
        <input type="text" id="freetext-filter">
    </label>

    <label for="is-installed-filter" class="filter-toggle">
        <input type="checkbox" id="is-installed-filter" data-filter-type="installed">
        <span>Show installed games only</span>
    </label>

    <label for="is-couch-coop-filter" class="filter-toggle">
        <input type="checkbox" id="is-couch-coop-filter" data-filter-type="couch-coop">
        <span>Show couch co-op games only</span>
    </label>

    <label for="is-favorite-filter" class="filter-toggle">
        <input type="checkbox" id="is-favorite-filter" data-filter-type="favorite">
        <span>Show favorite games only</span>
    </label>
</div>
